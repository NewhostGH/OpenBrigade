# OpenBrigade environment variables
# Copy this file to .env and edit as needed before running `docker compose up`
# Run `php artisan key:generate` on first install to set APP_KEY.

APP_NAME=OpenBrigade
APP_ENV=development # can be development OR production
APP_KEY=base64:A8oDA/qNrbo5TjFEfPD2nWqbdN+6Y0GvESCvD2plQss=
# Run: php artisan key:generate --show  and paste the output here
APP_DEBUG=true
APP_URL=http://localhost:8080
TRUST_PROXIES=*
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
# Surfaced by /health and reported to GlitchTip as the release.
APP_VERSION=dev

# Application port on the host
APP_PORT=8080

# DBGate (web DB browser) — only active under the "dev" Compose profile
DBGATE_PORT=8888

# Docker Compose stack to start. Profiles nest:
#   app     → app only
#   minimal → app + db
#   full    → app + db + clamav + GlitchTip
#   dev     → full + DBGate
COMPOSE_PROFILES=dev

# Database settings
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_NAME=openbrigade
DB_USER=openbrigade
DB_DATABASE=openbrigade
DB_USERNAME=openbrigade
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME_ROOT
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Optional: legacy source DB for row-count parity checks
# LEGACY_DB_HOST=legacy-db-host
# LEGACY_DB_PORT=3306
# LEGACY_DB_DATABASE=ebrigade_legacy
# LEGACY_DB_USERNAME=legacy_user
# LEGACY_DB_PASSWORD=legacy_password

# Upload limits (must match php.ini values)
MAX_UPLOAD_MB=20
MAX_LIST_ROWS=500

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Observability — error tracking (self-hosted Sentry / GlitchTip)
# The DSN is configured in the admin UI (Administration ▸ Journal d'activité ▸
# Paramètres), NOT here. SENTRY_LARAVEL_DSN remains an optional fallback that is
# imported into that setting on first migrate; leave it empty to manage the DSN
# entirely from the UI.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=

# GlitchTip server (part of the "full" / "dev" profiles)
GLITCHTIP_PORT=8000
GLITCHTIP_DOMAIN=http://localhost:8000
GLITCHTIP_SECRET_KEY=CHANGE_ME_GLITCHTIP_SECRET_KEY
GLITCHTIP_DB_PASSWORD=CHANGE_ME_GT
GLITCHTIP_FROM_EMAIL=glitchtip@openbrigade.local
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_OPEN_REGISTRATION=true

# Session settings
SESSION_DRIVER=database
SESSION_TABLE=sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SAME_SITE=strict
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=false

# Queue backend (Redis) — consumed by the queue-worker service.
# Use QUEUE_CONNECTION=sync to run jobs inline (no worker needed).
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — in dev, Mailpit (http://localhost:${MAILPIT_PORT}) catches everything.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@openbrigade.local
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_PORT=8025

# SMS gateway (provider-agnostic — see docs/admin/sms.md).
# SMS_DRIVER: log | smsgatewayme | null
SMS_DRIVER=log
SMS_FROM=OpenBrigade
SMSGATEWAYME_TOKEN=
SMSGATEWAYME_DEVICE_ID=

# Backups (DB + all stored files: photos, documents, RIB, theme…). Off-site copy is optional and S3-compatible.
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_KEEP=30
BACKUP_INCLUDE_FILES=true
BACKUP_RESTORE_DRILL=true
# Off-site mirror: set BACKUP_OFFSITE_DISK=s3 and fill the S3 block below.
BACKUP_OFFSITE_DISK=

# S3-compatible off-site storage (used when BACKUP_OFFSITE_DISK=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# SSL/TLS options for build/runtime tools
# Set NODE_TLS_REJECT_UNAUTHORIZED=0 only in trusted dev environments to ignore TLS certificate checks.
NODE_TLS_REJECT_UNAUTHORIZED=1
# Set COMPOSER_DISABLE_TLS=1 only when absolutely necessary (insecure).
COMPOSER_DISABLE_TLS=0

# Release verification (post-deploy smoke-check gate: `php artisan ob:release:verify`)
RELEASE_VERIFY_STRICT=false
RELEASE_EXPECTED_VERSION=
RELEASE_VERIFY_WEBHOOK_URL=
RELEASE_VERIFY_WEBHOOK_TIMEOUT=5
